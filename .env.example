# Create an OAuth Client ID of type "Web application" in Google Cloud.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Generate a random value, e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=3000
NODE_ENV=development

# Required for publicly deployed website (e.g. Render Key Value internal URL)
# REDIS_URL=redis://host:6379
# For Render change GOOGLE_REDIRECT_URI to https://YOUR-SITE.onrender.com/auth/google/callback
# For public deployment set NODE_ENV=production
